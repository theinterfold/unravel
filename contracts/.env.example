# Deployment config for `forge script script/DeployGame.s.sol`.

# Interfold + CRISP (required)
INTERFOLD_ADDRESS=
CRISP_PROGRAM_ADDRESS=

# Committee size (IInterfold.CommitteeSize): 0 Minimum, 1 Micro, 2 Small.
# Each maps to an m-of-n threshold configured on the Interfold deployment, not to a node count chosen
# here. Sepolia reads 2-of-3, 5-of-9 and 10-of-19. Asking for a size the deployment has not configured
# reverts with CommitteeSizeNotConfigured.
COMMITTEE_SIZE=0
# BFV parameter set: 0 = insecure-512 (fast local dev), 1 = secure-8192
PARAM_SET=0
COMPUTE_PROVIDER_PARAMS=

# Round shape. Every duration is a parameter, so the same contracts run a 9-day game
# or a compressed demo.
#
# CAMPAIGN_DURATION has a floor imposed by the network, not by taste: it has to outlast
# committee sortition and the DKG, because the ballot window opens at the end of it. Measure
# that floor on the target deployment before shortening this for a demo.
CAMPAIGN_DURATION=72000   # 20h
BALLOT_DURATION=10800     # 3h
TALLY_GRACE=3600          # 1h

# Teams. TEAM_COUNT and MEMBERS_PER_TEAM are each a ballot option count, so each is capped at 10 by
# the CRISP circuit's MAX_OPTIONS — 10 x 10 is the ceiling at 100 players, every ballot still provable.
TEAM_COUNT=4
MEMBERS_PER_TEAM=3
# Alive players at which teams dissolve and rounds become individual.
MERGE_AT=6
FINALISTS=2
# Consecutive missed check-ins before a player forfeits. 0 disables forfeits.
MAX_MISSED_CHECKINS=2
# Fee-token cost to join. 0 = play for glory.
ENTRY_FEE=0

# Deploy the public immunity election alongside the game. Off by default so the core
# loop can be proven before the public half is added.
ENABLE_IMMUNITY=false
