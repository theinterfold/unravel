# PUBLIC ENV VARS — UNRAVEL
# Static values below are the current Interfold Sepolia deployment.
# Game/token addresses come from `forge script DeployGame` output.

# Game contracts (from the deploy script's LIFE / JURY / GAME lines)
NEXT_PUBLIC_GAME_ADDRESS=
NEXT_PUBLIC_LIFE_TOKEN_ADDRESS=
NEXT_PUBLIC_JURY_TOKEN_ADDRESS=
# The block the game was deployed at — bounds the campaign-event scan.
NEXT_PUBLIC_GAME_DEPLOYMENT_BLOCK=

# Interfold
NEXT_PUBLIC_INTERFOLD_ADDRESS=
NEXT_PUBLIC_INTERFOLD_FEE_TOKEN_ADDRESS=0xb743cDE9fbC72Ba06654267d1970be72A4Ea1445  # Interfold testnet fee token
NEXT_PUBLIC_FAUCET_ADDRESS=0x47Ef2F9764623Fd6154F389BA5Ccc54874F6EeD3               # testnet faucet
NEXT_PUBLIC_ENABLE_FAUCET=true  # testnet only — leave unset/false in production

# CRISP — coordination server + E3 program.
# The server resolves eligibility by calling getCensus(e3Id) on the game contract, so no
# Etherscan key is needed for the roster.
NEXT_PUBLIC_CRISP_SERVER_URL="https://crisp-api.theinterfold.com"
NEXT_PUBLIC_CRISP_PROGRAM_ADDRESS=0x12f7a216aEaB6620dC3488754970b66c63ECdD2C

# Network and services
NEXT_PUBLIC_CHAIN_NAME=sepolia
NEXT_PUBLIC_SECONDS_PER_BLOCK=12
NEXT_PUBLIC_WEB3_ENDPOINT=https://eth-sepolia.g.alchemy.com/v2/           # your Alchemy/Infura key

# Campaign posts are pinned to IPFS; only the CID goes on-chain.
NEXT_PUBLIC_IPFS_ENDPOINTS="https://domain1/api,https://domain2/api/v0"
# SERVER-ONLY (no NEXT_PUBLIC_ prefix): read by pages/api/ipfs/pin.ts.
# A NEXT_PUBLIC_ prefix would inline this into the client bundle.
PINATA_JWT="..."

# SERVER-ONLY: read by pages/api/etherscan.ts.
ETHERSCAN_API_KEY="OPTIONAL: ETHERSCAN API"

# Optional — have sensible defaults in constants.ts
# NEXT_PUBLIC_PROJECT_URL="https://theinterfold.com/"
# NEXT_PUBLIC_CRISP_INFO_URL="https://docs.theinterfold.com/"
