# Copy to .env (gitignored) and fill in. Read by scripts/deploy-sepolia.sh.
#
# Anything already set in your environment wins over this file, so an inline
# `RPC_URL=... bun run deploy:sepolia` still overrides what is here.

# ─── Required ───────────────────────────────────────────────────────────────────────────────────

# Deployer key. Use a throwaway — the deploy broadcasts real transactions, and this file exists so
# the key stays out of your shell history, not because it is safe to reuse a real one.
PRIVATE_KEY=

# ─── Optional: network ──────────────────────────────────────────────────────────────────────────

# A public endpoint is the default. Swap in Alchemy/Infura if you hit rate limits — the deploy makes
# a lot of calls in a short window.
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ─── Optional: Sepolia targets ──────────────────────────────────────────────────────────────────
#
# Defaults are the current Interfold Sepolia deployment, taken from the-interfold-governance.
# Override only if you are pointing at a different one — a mismatched Interfold address makes
# `request` revert with empty data, which is close to undiagnosable from the revert alone.

# INTERFOLD_ADDRESS=0x13fA9Ecff929b4C86a2FCA4AEE91572EDee34486
# CRISP_PROGRAM_ADDRESS=0x12f7a216aEaB6620dC3488754970b66c63ECdD2C
# FEE_TOKEN_ADDRESS=0xb743cDE9fbC72Ba06654267d1970be72A4Ea1445
# FAUCET_ADDRESS=0x47Ef2F9764623Fd6154F389BA5Ccc54874F6EeD3
# CRISP_SERVER_URL=https://private-crisp.theinterfold.com

# ─── Optional: round shape ──────────────────────────────────────────────────────────────────────
#
# TEAM_COUNT and MEMBERS_PER_TEAM are both ballot option counts, so both are capped at 10 by the
# CRISP circuit. 10 x 10 is the maximum: 100 players, every ballot still provable.

# TEAM_COUNT=4
# MEMBERS_PER_TEAM=3
# MERGE_AT=6
# FINALISTS=2

# CAMPAIGN_DURATION must outlast committee sortition and the DKG, because the ballot window opens
# the moment it ends. Measure it on your first round rather than trusting this.
# CAMPAIGN_DURATION=900

# BALLOT_DURATION is sized for people, not the committee: each ballot is 45-90s of proof generation
# in the browser, and a full roster proving sequentially is the real constraint.
# BALLOT_DURATION=1800

# TALLY_GRACE=600
# MAX_MISSED_CHECKINS=2
# ENTRY_FEE=0
